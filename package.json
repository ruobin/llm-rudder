{
  "name": "llm-rudder",
  "version": "0.1.0",
  "private": true,
  "description": "Personal LLM gateway with tiered routing, failover and fallback warnings",
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @llm-rudder/gateway dev",
    "demo": "pnpm --filter @llm-rudder/gateway demo",
    "smoke:claude-code": "pnpm --filter @llm-rudder/edge smoke:claude-code",
    "smoke:codex": "pnpm --filter @llm-rudder/gateway smoke:codex",
    "smoke:clients": "pnpm --filter @llm-rudder/gateway smoke:clients",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
