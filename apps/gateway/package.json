{
  "name": "@llm-rudder/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@llm-rudder/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "cli": "tsx --conditions=@llm-rudder/source src/cli.ts",
    "demo": "tsx --conditions=@llm-rudder/source src/dev/demo.ts",
    "demo:dashboard": "tsx --conditions=@llm-rudder/source dev/dashboard-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "smoke:codex": "tsx --conditions=@llm-rudder/source dev/codex-smoke.ts",
    "smoke:clients": "tsx --conditions=@llm-rudder/source dev/clients-smoke.ts"
  },
  "dependencies": {
    "@llm-rudder/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "undici": "^8.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "openai": "^7.55.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
