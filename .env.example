# Copy to .env and run: chmod 600 .env
# Create keys with: docker compose run --rm gateway node dist/cli.js keygen NAME ...
# or, with Node installed: pnpm --filter @llm-router/gateway cli keygen NAME ...

# Public hostnames, used by the Caddy profile
LLMR_DOMAIN=llm.example.com
LLMR_CHAT_DOMAIN=chat.example.com

# Keys for the gateway itself: at least 32 characters, one per client
LLMR_ADMIN_KEY=
LLMR_KEY_OPENCODE=
LLMR_KEY_PI=
LLMR_KEY_CHAT_UI=
LLMR_KEY_SCRIPTS=
LLMR_KEY_CLAUDE_CODE=

# Upstream accounts
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MY_GATEWAY_BASE_URL=https://new-api.example.com/v1
MY_GATEWAY_API_KEY=

# Push warnings (optional). For ntfy, use a long, hard-to-guess topic.
LLMR_NTFY_URL=
LLMR_WEBHOOK_URL=

# Database. Use URL-safe values, such as the output of: openssl rand -hex 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Open WebUI (chat profile): output of openssl rand -hex 32
WEBUI_SECRET_KEY=

LOG_LEVEL=info
