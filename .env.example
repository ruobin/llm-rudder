# Copy to .env and run: chmod 600 .env
# Create keys with: docker compose run --rm gateway node dist/cli.js keygen NAME ...
# or, with Node installed: pnpm --filter @llm-rudder/gateway cli keygen NAME ...

# Public hostnames, used by the Caddy profile
LLMR_DOMAIN=llm.example.com
LLMR_CHAT_DOMAIN=chat.example.com

# Keys for the gateway itself: at least 32 characters, one per client
LLMR_ADMIN_KEY=
LLMR_KEY_OPENCODE=
LLMR_KEY_PI=
LLMR_KEY_CHAT_UI=
LLMR_KEY_SCRIPTS=
LLMR_KEY_CLAUDE_CODE=
LLMR_KEY_CODEX=

# Web dashboard (dashboard profile). Create these with:
# docker compose run --rm -T --no-deps gateway node dist/cli.js dashboard-secrets >> .env
LLMR_DASHBOARD_DOMAIN=dashboard.example.com

# Metrics and charts (monitoring profile). The key is one more keygen name.
LLMR_METRICS_KEY=
LLMR_GRAFANA_PASSWORD=

# Encrypts backups. Keep a copy elsewhere: without it, backups cannot be opened.
LLMR_BACKUP_PASSPHRASE=
# Optional off-site copy: user@host:/path, or rclone:remote:path
LLMR_BACKUP_REMOTE=

# Encrypts the ChatGPT sign-in on disk. Create it with: openssl rand -base64 32
LLMR_STATE_KEY=

# Upstream accounts
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MY_GATEWAY_BASE_URL=https://new-api.example.com/v1
MY_GATEWAY_API_KEY=

# Push warnings (optional). For ntfy, use a long, hard-to-guess topic.
LLMR_NTFY_URL=
LLMR_WEBHOOK_URL=
LLMR_TELEGRAM_BOT_TOKEN=
LLMR_TELEGRAM_CHAT_ID=

# Database. Use URL-safe values, such as the output of: openssl rand -hex 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Open WebUI (chat profile): output of openssl rand -hex 32
WEBUI_SECRET_KEY=

LOG_LEVEL=info
