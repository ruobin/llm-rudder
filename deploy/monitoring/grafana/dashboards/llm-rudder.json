      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (requested, served) (rate(llmr_tier_fallbacks_total[$__rate_interval])) * 3600",
