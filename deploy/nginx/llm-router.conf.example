# For a VPS that already runs Nginx. The gateway is published on 127.0.0.1:4141.
# Replace the hostname and the certificate paths.

server {
    listen 443 ssl;
    http2 on;
    server_name llm.example.com;

    ssl_certificate     /etc/letsencrypt/live/llm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/llm.example.com/privkey.pem;

    # Keys are sent in headers, so do not log them.
    access_log /var/log/nginx/llm-router.access.log;

    location /v1/ {
        proxy_pass http://127.0.0.1:4141;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwrite this header, so a client cannot fake its address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming needs these.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 32m;
    }

    # Used by llmr-edge. The rest of /router/ stays private.
    location /router/edge/ {
        proxy_pass http://127.0.0.1:4141;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwrite this header, so a client cannot fake its address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming needs these.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 32m;
    }

    # The model catalog for Codex.
    location /router/codex/ {
        proxy_pass http://127.0.0.1:4141;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwrite this header, so a client cannot fake its address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming needs these.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 32m;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:4141;
    }

    # /router/* stays private. Use an SSH tunnel to reach it.
    location / {
        return 404;
    }
}
